{
  "name": "zenith-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:ci": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "test-storybook --watch=false --ci",
    "storybook:serve": "npx serve storybook-static --listen 6006",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --coverageReporters=lcov --coverageReporters=text-summary",
    "test:coverage": "jest --coverage",
    "test:vrt": "playwright test --config playwright.storybook.config.ts",
    "size": "size-limit",
    "api:check": "node --import ./scripts/register.mjs scripts/api-check.ts"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "2.7.0",
    "@sentry/nextjs": "^7.120.2",
    "@stellar/freighter-api": "^2.0.0",
    "@stellar/stellar-sdk": "12.3.0",
    "@swc/core": "^1.16.12",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@playwright/test": "^1.50.1",
    "@size-limit/file": "14.1.0",
    "@storybook/addon-a11y": "^8.6.12",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-interactions": "^8.6.12",
    "@storybook/nextjs": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@storybook/test-runner": "^0.21.0",
    "@swc/core-linux-x64-gnu": "^1.16.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "babel-jest": "^30.5.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "msw": "^2.7.5",
    "msw-storybook-addon": "^2.0.4",
    "postcss": "^8",
    "size-limit": "14.1.0",
    "storybook": "^8.6.12",
    "tailwindcss": "^3.4.3",
    "ts-jest": "^29.4.14",
    "typescript": "^5",
    "webpack": "^5.94.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "size-limit": [
    {
      "name": "Shared vendor bundle (largest chunk)",
      "path": ".next/static/chunks/eef1a047-*.js",
      "limit": "280 kB",
      "gzip": true
    },
    {
      "name": "React framework chunk",
      "path": ".next/static/chunks/framework-*.js",
      "limit": "60 kB",
      "gzip": true
    },
    {
      "name": "Page: / (home)",
      "path": ".next/static/chunks/app/page-*.js",
      "limit": "10 kB",
      "gzip": true
    },
    {
      "name": "Page: /options",
      "path": ".next/static/chunks/app/options/page-*.js",
      "limit": "5 kB",
      "gzip": true
    },
    {
      "name": "Page: /portfolio",
      "path": ".next/static/chunks/app/portfolio/page-*.js",
      "limit": "35 kB",
      "gzip": true
    },
    {
      "name": "Page: /history",
      "path": ".next/static/chunks/app/history/page-*.js",
      "limit": "10 kB",
      "gzip": true
    }
  ]
}
