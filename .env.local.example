# Backend per environment mode (src/lib/env/networks.ts). A mode with no URL
# is still selectable but refuses to make API calls rather than falling back
# to another mode's backend.
NEXT_PUBLIC_API_URL=http://localhost:8081           # paper trading (default mode)
# NEXT_PUBLIC_TESTNET_API_URL=
# NEXT_PUBLIC_MAINNET_API_URL=

# Soroban RPC + contract IDs (not used by the paper backend)
# NEXT_PUBLIC_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_TESTNET_VAULT_CONTRACT_ID=
# NEXT_PUBLIC_TESTNET_ORACLE_CONTRACT_ID=
# NEXT_PUBLIC_MAINNET_RPC_URL=
# NEXT_PUBLIC_MAINNET_VAULT_CONTRACT_ID=
# NEXT_PUBLIC_MAINNET_ORACLE_CONTRACT_ID=
